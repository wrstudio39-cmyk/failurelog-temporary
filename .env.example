# Supabase — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe — from the Stripe dashboard (test keys while building)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# GitHub OAuth is configured inside the Supabase dashboard
# (Authentication → Providers → GitHub), not here.

# Phase 2 — Stripe Connect / verification / messaging / newsletter
STRIPE_CONNECT_CLIENT_ID=
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
NEWSLETTER_PROVIDER_URL=
NEWSLETTER_PROVIDER_API_KEY=
NEWSLETTER_LIST_ID=

# Server-only key used by the protected admin control plane. NEVER expose this in NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
